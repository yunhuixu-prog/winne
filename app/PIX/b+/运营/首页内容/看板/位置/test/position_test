select Date,data_type,case when version>='7.7.000' then '>=7.7.000'
      when version<'7.7.000' then '<7.7.000'
 else 'null'
 end Version_status
  ,sum(case when Module_position='6' and Event_name='home_module_show_f_bd' then Amount end)
  ,sum(case when Module_position='1' and Event_name='home_module_show_f_bd' then Amount end)
  ,sum(case when Module_position='6' and Event_name='home_module_show_f_bd' then Amount end)/sum(case when Module_position='1' and Event_name='home_module_show_f_bd' then Amount end)
  ,sum(case when Event_name='home_second_page_appr_bd' then Amount end)
  ,sum(case when Event_name='homepageappr_bd' then Amount end)
  ,sum(case when Event_name='home_second_page_appr_bd' then Amount end)/sum(case when Event_name='homepageappr_bd' then Amount end)
from
