                        and is_active_30 between 0 and 1
                        and is_edit_selfi_30 between 0 and 1
                        and is_active_60 between 0 and 1
                        and is_edit_selfi_60 between 0 and 1
                        and is_active_90 between 0 and 1
                        and is_edit_selfi_90 between 0 and 1
